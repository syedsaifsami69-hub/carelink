# Postgres connection (docker compose up -d db gives you this one locally)
DATABASE_URL=postgresql://carelink:carelink_dev_only@localhost:5432/carelink
PORT=3001
# production: set NODE_ENV=production so cookies are Secure and dev seeding is refused
NODE_ENV=development
# Hours a patient access code stays valid after it is issued
PATIENT_ACCESS_TTL_HOURS=72
# Hours a code stays valid after the visit is marked Done
PATIENT_ACCESS_AFTER_DONE_HOURS=24
# Folder for uploaded lab files (must not be inside dist/ or public/)
STORAGE_DIR=./storage
