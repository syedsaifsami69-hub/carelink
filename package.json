{
  "name": "carelink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "npm run build && prisma migrate deploy && node --env-file-if-exists=.env server/index.js",
    "postinstall": "prisma generate",
    "db:local": "node scripts/local-db.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "@heroui/styles": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "embedded-postgres": "^18.6.0-beta.19",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "supertest": "^7.3.1",
    "vite": "^8.1.1",
    "vitest": "^5.1.0"
  }
}
